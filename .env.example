# Frontend settings (apps/web)
# For production deployments on Vercel:
# 1. Leave NEXT_PUBLIC_API_BASE_URL unset or empty to use same-origin proxy rewrites (/api -> Render).
# 2. Set BACKEND_API_URL to the target backend (e.g., https://repopilot-fix.onrender.com).
# For local development with direct API calls without Next.js proxy, use http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=
BACKEND_API_URL=http://localhost:8000

# Backend settings. Apply schema with: alembic -c apps/api/alembic.ini upgrade head
DATABASE_URL=postgresql+psycopg://repopilot:repopilot@localhost:5432/repopilot
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Local development only. Use COOKIE_SECURE=true over HTTPS in production.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800

# Create a GitHub OAuth App with callback:
# http://localhost:8000/api/auth/github/callback
# Keep client credentials on the backend; never use NEXT_PUBLIC_ prefixes.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Public source indexing safety limits (per repository job)
INDEX_MAX_FILES=300
INDEX_MAX_FILE_BYTES=200000
INDEX_MAX_API_REQUESTS=350

# Repository chat: mock is free and local; cloud supports OpenAI-compatible APIs (e.g. Google Gemini).
CHAT_PROVIDER=mock
# Required only for openai_compatible; keep credentials server-side.
# For Google Gemini (Google AI Studio Free Tier):
# CHAT_PROVIDER=openai_compatible
# CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CHAT_MODEL=gemini-2.5-flash
# CHAT_API_KEY=your_gemini_api_key
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=

# Protect free-tier AI quota from anonymous visitors:
# When false (default), guest sessions use deterministic mock AI. Authenticated users use live AI.
ALLOW_PUBLIC_AI=false

# On-demand GitHub Actions verification worker dispatch (Render -> GitHub Actions):
# Fine-grained GitHub personal access token requiring only 'Actions: write' scope
# (Repository permissions: Actions -> Read and write). Does NOT require Contents: write.
GITHUB_WORKER_DISPATCH_TOKEN=
GITHUB_REPOSITORY=Mehndi-Hassan28/repopilot-fix
GITHUB_WORKER_WORKFLOW=verification-worker.yml
GITHUB_WORKER_REF=main

# Least-privilege PostgreSQL worker credentials for GitHub Actions secrets (secrets.DATABASE_URL):
# For dedicated restricted worker role without access to auth/sessions (see docs/deployment/deployment_guide.md for SQL):
# DATABASE_URL=postgresql+psycopg://repopilot_worker:worker_pass@<host>/repopilot?sslmode=require
