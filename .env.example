# Browser-visible API base URL; do not put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend settings. Apply schema with: alembic -c apps/api/alembic.ini upgrade head
DATABASE_URL=postgresql+psycopg://repopilot:repopilot@localhost:5432/repopilot
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Local development only. Use COOKIE_SECURE=true over HTTPS in production.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800

# Create a GitHub OAuth App with callback:
# http://localhost:8000/api/auth/github/callback
# Keep client credentials on the backend; never use NEXT_PUBLIC_ prefixes.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Public source indexing safety limits (per repository job)
INDEX_MAX_FILES=300
INDEX_MAX_FILE_BYTES=200000
INDEX_MAX_API_REQUESTS=350

# Repository chat: mock is free and local; cloud supports OpenAI-compatible APIs.
CHAT_PROVIDER=mock
# Required only for openai_compatible; keep credentials server-side.
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
